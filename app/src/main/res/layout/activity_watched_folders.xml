<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <TextView
        android:id="@+id/txt_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:text="New files in these folders are backed up automatically. Tap a folder for its advanced settings."
        android:textColor="?attr/colorOnSurface"
        android:alpha="0.75"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txt_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="No folders yet. Tap Add Folder to pick Downloads, DCIM, Pictures and more."
        android:textColor="?attr/colorOnSurface"
        android:alpha="0.7"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_interval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Scan interval"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/txt_interval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Every hour"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fab_add"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="14dp"
        android:text="+  Add Folder"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="?attr/colorOnPrimary"
        app:backgroundTint="@null"
        android:background="@drawable/bg_gradient_button"
        app:cornerRadius="16dp" />
</LinearLayout>
