    <style name="Theme.SvnSpace.Terminal" parent="Theme.SvnSpace">
        <item name="colorPrimary">@color/terminal_primary</item>
        <item name="colorSecondary">@color/tron_blue</item>
        <item name="colorSurface">@color/terminal_surface</item>
        <item name="colorOnSurface">@color/terminal_on</item>
        <item name="android:windowBackground">@color/terminal_surface</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="Theme.SvnSpace.Void" parent="Theme.SvnSpace">
