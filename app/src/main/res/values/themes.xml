<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SvnSpace" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/svn_cyan</item>
        <item name="colorSecondary">@color/svn_purple</item>
        <item name="colorSurface">@color/svn_surface</item>
        <item name="colorOnSurface">@color/svn_text</item>
        <item name="colorOnPrimary">@color/void_black</item>
        <item name="android:statusBarColor">@color/svn_bg</item>
        <item name="android:navigationBarColor">@color/svn_bg</item>
        <item name="android:windowBackground">@color/svn_bg</item>
        <item name="android:colorBackground">@color/svn_bg</item>
    </style>

    <style name="Theme.SvnSpace.Transparent" parent="Theme.SvnSpace">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="Theme.SvnSpace.Eggplant" parent="Theme.SvnSpace">
        <item name="colorPrimary">@color/eggplant_primary</item>
        <item name="colorSecondary">@color/eggplant_secondary</item>
        <item name="colorSurface">@color/eggplant_surface</item>
        <item name="colorOnSurface">@color/eggplant_on</item>
        <item name="android:windowBackground">@color/eggplant_surface</item>
    </style>

    <style name="Theme.SvnSpace.Aurora" parent="Theme.SvnSpace">
        <item name="colorPrimary">@color/aurora_primary</item>
        <item name="colorSecondary">@color/aurora_secondary</item>
        <item name="colorSurface">@color/aurora_surface</item>
        <item name="colorOnSurface">@color/aurora_on</item>
        <item name="android:windowBackground">@color/aurora_surface</item>
    </style>

    <style name="Theme.SvnSpace.Sunset" parent="Theme.SvnSpace">
        <item name="colorPrimary">@color/sunset_primary</item>
        <item name="colorSecondary">@color/sunset_secondary</item>
        <item name="colorSurface">@color/sunset_surface</item>
        <item name="colorOnSurface">@color/sunset_on</item>
        <item name="android:windowBackground">@color/sunset_surface</item>
    </style>

    <style name="Theme.SvnSpace.Retrowave" parent="Theme.SvnSpace">
        <item name="colorPrimary">@color/retrowave_primary</item>
        <item name="colorSecondary">@color/retrowave_secondary</item>
        <item name="colorSurface">@color/retrowave_surface</item>
        <item name="colorOnSurface">@color/retrowave_on</item>
        <item name="android:windowBackground">@color/retrowave_surface</item>
    </style>

    <style name="Theme.SvnSpace.Neon" parent="Theme.SvnSpace">
        <item name="colorPrimary">@color/neon_primary</item>
        <item name="colorSecondary">@color/neon_secondary</item>
        <item name="colorSurface">@color/neon_surface</item>
        <item name="colorOnSurface">@color/neon_on</item>
        <item name="android:windowBackground">@color/neon_surface</item>
    </style>

    <style name="Theme.SvnSpace.Cyberpunk" parent="Theme.SvnSpace">
        <item name="colorPrimary">@color/cyberpunk_primary</item>
        <item name="colorSecondary">@color/cyberpunk_secondary</item>
        <item name="colorSurface">@color/cyberpunk_surface</item>
        <item name="colorOnSurface">@color/cyberpunk_on</item>
        <item name="android:windowBackground">@color/cyberpunk_surface</item>
    </style>

    <style name="Theme.SvnSpace.Terminal" parent="Theme.SvnSpace">
        <item name="colorPrimary">@color/terminal_primary</item>
        <item name="colorSecondary">@color/tron_blue</item>
        <item name="colorSurface">@color/terminal_surface</item>
        <item name="colorOnSurface">@color/terminal_on</item>
        <item name="android:windowBackground">@color/terminal_surface</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="Theme.SvnSpace.Void" parent="Theme.SvnSpace">
        <item name="colorPrimary">@color/void_primary</item>
        <item name="colorSecondary">@color/void_secondary</item>
        <item name="colorSurface">@color/void_surface</item>
        <item name="colorOnSurface">@color/void_on</item>
        <item name="android:windowBackground">@color/void_surface</item>
