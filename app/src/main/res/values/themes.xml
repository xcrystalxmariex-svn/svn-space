    <style name="Theme.SvnSpace.Alexandrite" parent="Theme.SvnSpace">
        <item name="colorPrimary">@color/alex_primary</item>
        <item name="colorSecondary">@color/alex_secondary</item>
        <item name="colorSurface">@color/alex_surface</item>
        <item name="colorOnSurface">@color/alex_on</item>
        <item name="android:windowBackground">@color/alex_surface</item>
    </style>

    <style name="Widget.SvnSpace.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/svn_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/svn_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.SvnSpace.GradientButton" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_gradient_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>
