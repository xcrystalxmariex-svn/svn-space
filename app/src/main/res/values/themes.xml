    </style>

    <style name="Theme.SvnSpace.Neon" parent="Theme.SvnSpace">
        <item name="colorPrimary">@color/neon_primary</item>
        <item name="colorSecondary">@color/neon_secondary</item>
        <item name="colorSurface">@color/neon_surface</item>
        <item name="colorOnSurface">@color/neon_on</item>
        <item name="android:windowBackground">@color/neon_surface</item>
