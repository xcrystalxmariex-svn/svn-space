<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Follows system light/dark via DayNight; values-night overrides when dark -->
    <style name="Theme.SvnSpace.System" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#0EA5E9</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#7C3AED</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#0F172A</item>
        <item name="colorSurfaceVariant">#F1F5F9</item>
        <item name="colorOnSurfaceVariant">#475569</item>
        <item name="colorOutline">#CBD5E1</item>
        <item name="android:colorBackground">#F8FAFC</item>
        <item name="colorOnBackground">#0F172A</item>
        <item name="android:statusBarColor">#F8FAFC</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowBackground">#F8FAFC</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

