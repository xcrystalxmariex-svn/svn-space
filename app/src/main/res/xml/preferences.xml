<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_category_watched">
        <Preference
            app:key="pref_manage_watched"
            app:title="@string/pref_manage_watched"
            app:summary="Add Downloads or any folder, toggle it, tap it to set where it backs up" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_connections">
        <Preference
            app:key="pref_add_connection"
            app:title="@string/pref_add_connection"
            app:summary="OAuth providers or username/password remote (WebDAV, SFTP, etc.)" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_scan">
        <ListPreference
            app:key="pref_scan_interval"
            app:title="@string/pref_scan_interval"
            app:summary="How often watched folders are scanned"
            app:defaultValue="1"
            app:entries="@array/scan_interval_labels"
            app:entryValues="@array/scan_interval_values" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_appearance">
        <ListPreference
            app:key="pref_theme"
            app:title="@string/pref_theme"
            app:summary="System, dark, light, eggplant, aurora, sunset, retrowave, neon, cyberpunk, terminal, void, alexandrite"
            app:defaultValue="alexandrite" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_advanced">
        <Preference
            app:key="pref_advanced_info"
            app:title="Per-folder advanced settings"
            app:summary="Choose where each watched folder backs up to, the remote folder and which file types" />
    </PreferenceCategory>

</PreferenceScreen>
