<?xml version="1.0" encoding="utf-8"?>
<!-- Planet horizon: a huge dark disc with a glowing blue/violet rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60%p"
                android:centerY="0.0"
                android:startColor="#FF7C3AED"
                android:centerColor="#FF312E81"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item android:top="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FF101A44"
                android:endColor="#FF03040F" />
            <stroke android:width="2dp" android:color="#AA60A5FA" />
        </shape>
    </item>
</layer-list>
